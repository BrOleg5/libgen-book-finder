{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/BrOleg5/libgen-book-finder",
  "browser_specific_settings": {
    "gecko": {
      "id": "libgen-book-finder@broleg5",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage", "contextMenus", "<all_urls>"],
  "background": {
    "scripts": [
      "lib/isbn.js",
      "lib/doi.js",
      "lib/libgen.js",
      "lib/settings.js",
      "background/background.js"
    ]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["lib/isbn.js", "lib/doi.js", "content/book-finder.js"],
    "run_at": "document_idle"
  }],
  "browser_action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html"
  },
  "page_action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "__MSG_actionTitle__",
    "pinned": true
  },
  "options_ui": { "page": "popup/popup.html", "open_in_tab": false },
  "commands": {
    "search-in-libgen": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "__MSG_commandOpen__"
    }
  }
}
