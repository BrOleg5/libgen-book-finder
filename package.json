{
  "name": "libgen-book-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox extension that finds a book on the current page and opens a Library Genesis search.",
  "license": "MIT",
  "scripts": {
    "build": "web-ext build",
    "lint": "web-ext lint",
    "start": "web-ext run",
    "sign": "web-ext sign --channel listed --approval-timeout 0",
    "test": "node test/isbn.test.js && node test/libgen.test.js"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
